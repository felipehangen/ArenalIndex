{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/admin.mjs": {
      "maxDuration": 60,
      "includeFiles": "{server/admin/**,server/portal/**,server/intake/**,site/newlisting/model.mjs}"
    },
    "api/owner.mjs": {
      "maxDuration": 60,
      "includeFiles": "{server/admin/**,server/portal/**,server/intake/**,site/newlisting/model.mjs}"
    },
    "api/listings.mjs": {
      "maxDuration": 60,
      "includeFiles": "server/intake/**"
    },
    "api/intake.mjs": {
      "maxDuration": 60,
      "includeFiles": "{server/intake/**,site/newlisting/model.mjs}"
    }
  },
  "headers": [
    {
      "source": "/owner/(.*)",
      "headers": [
        {"key": "Cache-Control", "value": "no-store"},
        {"key": "Referrer-Policy", "value": "no-referrer"},
        {"key": "X-Robots-Tag", "value": "noindex, nofollow"}
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        {"key": "Cache-Control", "value": "no-store"},
        {"key": "Referrer-Policy", "value": "no-referrer"},
        {"key": "X-Robots-Tag", "value": "noindex, nofollow"}
      ]
    },
    {
      "source": "/newlisting/review/(.*)",
      "headers": [
        {"key": "Cache-Control", "value": "no-store"},
        {"key": "Referrer-Policy", "value": "no-referrer"},
        {"key": "X-Robots-Tag", "value": "noindex, nofollow"}
      ]
    }
  ]
}
