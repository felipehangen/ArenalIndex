{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/admin.mjs": {
      "maxDuration": 60,
      "includeFiles": "{server/admin/**,server/portal/**,server/intake/**,server/catalog/**,site/newlisting/model.mjs,site/publicar/rules.mjs}"
    },
    "api/owner.mjs": {
      "maxDuration": 60,
      "includeFiles": "{server/admin/**,server/portal/**,server/intake/**,server/catalog/**,site/newlisting/model.mjs,site/publicar/rules.mjs}"
    },
    "api/listings.mjs": {
      "maxDuration": 60,
      "includeFiles": "{server/intake/**,server/catalog/**}"
    },
    "api/intake.mjs": {
      "maxDuration": 60,
      "includeFiles": "{server/intake/**,server/catalog/**,site/newlisting/model.mjs}"
    }
  },
  "headers": [
    {
      "source": "/cuenta/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/owner/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/newlisting/review/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
